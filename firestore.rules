rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Tạm thời: cho phép tất cả read/write ──────────────────────────
    // TODO: Thêm Firebase Auth (Custom Token từ Zalo) khi upgrade Blaze plan
    // Sau đó khôi phục rules có isAuthenticated(), isOwner(), isTeacher()

    // ── Users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // ── Classes ───────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ── Sessions ──────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if true;
    }

    // ── Session secrets ─────────────────────────────────────────────
    match /sessions/{sessionId}/secrets/{secretId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Attendance ────────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // ── Face registrations ────────────────────────────────────────────
    match /face_registrations/{docId} {
      allow read, write: if true;
    }

    // ── OAuth states ─────────────────────────────────────────────────
    match /oauth_states/{stateId} {
      allow read, write: if false;
    }

    // ── Fraud reports ─────────────────────────────────────────────────
    match /fraud_reports/{reportId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // ── Absence requests ────────────────────────────────────────────────
    match /absence_requests/{requestId} {
      allow read: if true;
      allow create, update: if true;
    }
  }
}
