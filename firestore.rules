rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vì project chạy Firebase Spark (free) + chưa có Custom Auth Token từ Zalo,
    // client KHÔNG có `request.auth`. Rules vẫn phải đóng các đường thoát rõ ràng:
    //  1. Cấm client tự gán `role` (chống self-elevation thành teacher/admin).
    //  2. Bảo vệ các collection chỉ-đọc (fraud reports, OTP states).
    //
    // TODO (production): bật Blaze plan + Custom Token để dùng request.auth.uid
    //                    và khôi phục isOwner()/isTeacher() đầy đủ.

    function notChangingRole() {
      return !('role' in request.resource.data) ||
             !('role' in resource.data) ||
             request.resource.data.role == resource.data.role;
    }

    function newDocSafeRole() {
      // User mới tạo: chỉ chấp nhận role="student" hoặc thiếu role.
      return !('role' in request.resource.data) ||
             request.resource.data.role == 'student';
    }

    // ── Users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      // Tạo user mới: role phải là "student" (teacher/admin do Cloud Function gán).
      allow create: if newDocSafeRole();
      // Update: không được tự đổi role của bản thân.
      allow update: if notChangingRole();
      allow delete: if false;
    }

    // ── Classes ───────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── Sessions ──────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── Session secrets — HMAC keys ──────────────────────────────────
    // TODO: khi có Auth, chỉ teacher của session đọc được.
    match /sessions/{sessionId}/secrets/{secretId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Attendance ────────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── Face registrations ────────────────────────────────────────────
    match /face_registrations/{docId} {
      allow read, write: if true;
    }

    // ── Verified students (email OTP) ─────────────────────────────────
    match /verified_students/{userId} {
      allow read, write: if true;
    }

    // ── OAuth states — server-only ───────────────────────────────────
    match /oauth_states/{stateId} {
      allow read, write: if false;
    }

    // ── Fraud reports — Cloud Functions only ─────────────────────────
    match /fraud_reports/{reportId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Absence requests ──────────────────────────────────────────────
    // SV gửi đơn (create), GV/Admin duyệt (update). Status mặc định "pending".
    match /absence_requests/{requestId} {
      allow read: if true;
      // SV tạo mới: status PHẢI là "pending" (không được tự duyệt cho mình).
      allow create: if request.resource.data.status == 'pending';
      // Update: bất kỳ ai cũng update được (vì chưa có Auth, nhưng Admin UI dùng).
      allow update: if true;
      allow delete: if false;
    }

    // ── Teacher invite codes ──────────────────────────────────────────
    match /teacher_invites/{codeId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Pairing tokens — máy tính lớp học ↔ Mini App GV ──────────────
    // Web tạo token "pending" 60s, Mini App quét và update → "paired".
    // Một-lần-claim: chỉ pending → paired, không revert.
    match /pairing_tokens/{token} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
                 && request.resource.data.sessionId == null;
      allow update: if resource.data.status == 'pending'
                 && request.resource.data.status == 'paired'
                 && request.resource.data.sessionId is string;
      allow delete: if false;
    }
  }
}
