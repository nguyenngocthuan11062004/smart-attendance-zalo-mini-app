# ──────────────────────────────────────────────────────────────
# Zimo Check-in — Mini App (.env mẫu)
# Sao chép file này thành ".env" rồi điền giá trị thật.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Firebase — lấy tại: Firebase Console → Project Settings → Web app config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# AI Chat — Groq (Llama 3.3 70B), lấy miễn phí tại https://console.groq.com
VITE_GROQ_API_KEY=gsk_your_groq_api_key

# Xác minh email sinh viên qua EmailJS (https://www.emailjs.com) — tùy chọn
# Nếu để trống: bỏ qua bước xác minh email khi đăng nhập (chế độ dev/demo)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# MSSV bỏ qua xác minh email (chỉ DEV) — danh sách phân tách bằng dấu phẩy
VITE_BYPASS_MSSV=
