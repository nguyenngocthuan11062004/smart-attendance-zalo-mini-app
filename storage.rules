rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Face images: only the owner can read/write their own face data
    match /faces/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Báo cáo điểm danh GV xuất ra (CSV). Mini App dùng Zalo OAuth — KHÔNG có
    // Firebase Auth nên không thể dựa request.auth. Mở đọc/ghi cho path exports/
    // (đồng bộ với posture rules Firestore hiện tại đang là `if true`).
    // TODO bảo mật: siết bằng Cloud Function ký URL / token khi có backend.
    match /exports/{allPaths=**} {
      allow read, write: if true;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
